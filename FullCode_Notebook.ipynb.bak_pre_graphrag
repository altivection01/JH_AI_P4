  {
   "cell_type": "markdown",
   "metadata": {
    "id": "lGju7rFcj9cA"
   },
   "source": [
    "Load each PDF and store the documents."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "  Coal2025              128 pages\n",
      "  Electricity2026       225 pages\n",
      "  Gas2025               125 pages\n",
