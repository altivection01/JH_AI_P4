    "test_query = BENCHMARK_QUERIES[0]\n",
    "docs = graph_rag_retrieve(test_query, vector_index, g, k_seed=4, k_expansion=4)\n",
    "\n",
    "print(f\"Query: {test_query}\\n\")\n",
    "print(f\"Retrieved {len(docs)} chunks\\n\")\n",
    "for d in docs:\n",
