   "source": [
    "import pandas as pd\n",
    "\n",
    "raw = pd.read_csv(\"ragas_gpt41_raw.csv\")\n",
    "sub = raw[raw[\"technique\"].isin([\"graph_rag\", \"graph_rag_cov\"])\n",
    "          & raw[\"answer_relevancy\"].notna()]\n",
    "\n",
    "print(\"=== Standard RAGAS metrics (n=5 trials each, gpt-4.1 judge) ===\")\n",
    "print()\n",
